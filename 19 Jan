Products Sold in 2024 but Not in 2025
Identify discontinued products.

Discontinued Products =
VAR Products2024 =
    CALCULATETABLE(
        VALUES(Sales[ProductID]),
        'Date'[Year] = 2024
    )

VAR Products2025 =
    CALCULATETABLE(
        VALUES(Sales[ProductID]),
        'Date'[Year] = 2025
    )

RETURN
    EXCEPT(Products2024, Products2025)

